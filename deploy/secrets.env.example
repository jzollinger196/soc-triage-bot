# /etc/soc-triage/secrets.env  (owner root, group soctriage, mode 0640)
# Only fill in what you use. Lines are KEY=value; no quotes needed.

# Wazuh indexer user for the dashboard index (README section 10).
SOC_TRIAGE_INDEXER_USER=
SOC_TRIAGE_INDEXER_PASSWORD=

# Ticketing - pick the one matching ticketing.system
# GitHub: fine-grained token with "Issues: Read and write" on the incident repo only
SOC_TRIAGE_GITHUB_TOKEN=
# Jira Cloud: your Atlassian email + an API token. Jira Server/DC: leave EMAIL empty and use a PAT.
SOC_TRIAGE_JIRA_EMAIL=
SOC_TRIAGE_JIRA_TOKEN=
# TheHive: API key of a dedicated analyst account
SOC_TRIAGE_THEHIVE_KEY=

# Only for llm.provider = "openai"
SOC_TRIAGE_API_KEY=
