<!-- soc-triage-bot: send alerts to the triage bot. Appended to /var/ossec/etc/ossec.conf
     (Wazuh accepts several <ossec_config> sections in one file). Same content as
     ossec-integration.xml, wrapped so it can be appended with one command. -->
<ossec_config>
  <!-- Every alert at level 10 or higher goes to the triage bot. -->
  <integration>
    <name>custom-soc-triage</name>
    <level>10</level>
    <alert_format>json</alert_format>
  </integration>

  <!-- Successful logins too, so the bot can spot "login after brute force". -->
  <integration>
    <name>custom-soc-triage</name>
    <group>authentication_success</group>
    <alert_format>json</alert_format>
  </integration>
</ossec_config>
